<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_120"
    android:paddingLeft="@dimen/vs_15"
    android:paddingTop="@dimen/vs_8"
    android:paddingRight="@dimen/vs_15"
    android:paddingBottom="@dimen/vs_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_10"
        android:paddingTop="@dimen/vs_8"
        android:paddingRight="@dimen/vs_10"
        android:paddingBottom="@dimen/vs_8">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/vs_48"
                android:layout_height="@dimen/vs_48"
                android:src="@drawable/icon_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:text="首页"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_live"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/vs_48"
                android:layout_height="@dimen/vs_48"
                android:src="@drawable/icon_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:text="直播"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/vs_48"
                android:layout_height="@dimen/vs_48"
                android:src="@drawable/icon_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:text="历史/收藏"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_setting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/vs_48"
                android:layout_height="@dimen/vs_48"
                android:src="@drawable/icon_setting" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:text="设置"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
