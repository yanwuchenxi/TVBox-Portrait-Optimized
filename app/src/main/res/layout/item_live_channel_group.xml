<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_8"
    android:layout_marginTop="@dimen/vs_4"
    android:layout_marginRight="@dimen/vs_8"
    android:layout_marginBottom="@dimen/vs_4"
    android:background="@drawable/bg_live_channel_group_item"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvChannelGroupName"
        android:layout_width="0dp"
        android:layout_height="@dimen/vs_60"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingLeft="@dimen/vs_6"
        android:paddingRight="@dimen/vs_6"
        android:singleLine="true"
        android:textColor="#EFF4FB"
        android:textSize="@dimen/ts_18" />
</LinearLayout>
