<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃：详情页海报容器 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/preview_player_radius" />
            <gradient
                android:angle="270"
                android:startColor="#400CADE2"
                android:endColor="#1A0CADE2" />
            <stroke android:width="@dimen/vs_2" android:color="#CC0CADE2" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/preview_player_radius" />
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#0DFFFFFF" />
            <stroke android:width="@dimen/vs_2" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
