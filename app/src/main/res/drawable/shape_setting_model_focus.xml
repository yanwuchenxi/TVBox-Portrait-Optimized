<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃：模型/选项条目 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <gradient
                android:angle="270"
                android:startColor="#4D0CADE2"
                android:endColor="#260CADE2" />
            <stroke android:width="@dimen/vs_2" android:color="#CC0CADE2" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <gradient
                android:angle="270"
                android:startColor="#4D0CADE2"
                android:endColor="#260CADE2" />
            <stroke android:width="@dimen/vs_2" android:color="#CC0CADE2" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#12FFFFFF" />
            <stroke android:width="@dimen/vs_1" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
