<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃：片源标签 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="40mm" />
            <gradient
                android:angle="270"
                android:startColor="#400CADE2"
                android:endColor="#1A0CADE2" />
            <stroke android:width="@dimen/vs_2" android:color="#B30CADE2" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="40mm" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#12FFFFFF" />
            <stroke android:width="@dimen/vs_2" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
