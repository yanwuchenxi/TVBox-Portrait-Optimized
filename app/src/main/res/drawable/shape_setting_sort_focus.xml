<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃：排序/筛选标签 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="40mm" />
            <gradient
                android:angle="270"
                android:startColor="#4D0CADE2"
                android:endColor="#260CADE2" />
            <stroke android:width="@dimen/vs_2" android:color="#CC0CADE2" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="40mm" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
