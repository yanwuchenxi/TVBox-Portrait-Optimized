<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <gradient
                android:angle="270"
                android:startColor="#550CADE2"
                android:endColor="#220CADE2" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="#AA0CADE2" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <gradient
                android:angle="270"
                android:startColor="#440CADE2"
                android:endColor="#180CADE2" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="#880CADE2" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
